{
  "name": "clearsend-outlook-addin",
  "version": "1.2.0",
  "description": "Review, deduplicate and organize Outlook recipients with local processing and optional aggregate usage counts",
  "repository": {
    "type": "git",
    "url": "https://github.com/fhuerta01/ClearSend.git"
  },
  "license": "MIT",
  "config": {
    "app_to_debug": "outlook",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production && node tests/build-check.cjs",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "lint": "eslint src api tests webpack.config.js --max-warnings 0",
    "lint:fix": "eslint src api tests webpack.config.js --fix",
    "prettier": "prettier --write src api tests webpack.config.js",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "start": "office-addin-debugging start manifest.xml",
    "start:prod": "office-addin-debugging start manifest.prod.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "stop:prod": "office-addin-debugging stop manifest.prod.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "validate:prod": "office-addin-manifest validate manifest.prod.xml",
    "watch": "webpack --mode development --watch",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run lint && npm test && npm run build && npm run validate && npm run validate:prod"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.377",
    "office-addin-debugging": "^7.0.0",
    "office-addin-dev-certs": "^3.0.0",
    "office-addin-manifest": "^3.0.0",
    "office-addin-prettier-config": "^3.0.0",
    "webpack-dev-server": "^6.0.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.25.4",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "office-addin-dev-settings": "^4.0.0",
    "eslint": "^10.10.0",
    "@eslint/js": "^10.0.1",
    "globals": "^17.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.0.0"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ],
  "dependencies": {
    "core-js": "^3.36.0",
    "regenerator-runtime": "^0.14.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.0.0"
  },
  "overrides": {
    "adm-zip": "^0.6.1"
  }
}
