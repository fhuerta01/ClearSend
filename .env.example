# Defaults: no client analytics and no server writes. Never commit real credentials.
# Only this public origin is injected into the browser at build time.
CLEARSEND_ANALYTICS_ORIGIN=
# Server-only variables; enable only for a reviewed production deployment.
ANALYTICS_ENABLED=false
ANALYTICS_ALLOWED_ORIGIN=https://clearsend.vercel.app
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
